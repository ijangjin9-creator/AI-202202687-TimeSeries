   "source": [
    "## 3. 트레이딩 전략: 확률 기반 포지션 조절"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 예측 함수 (확률 포함)",
    "def predict_with_probability(model, data_loader):",
    "    \"\"\"
    "    모델 예측 및 확률 반환",
    "    \"\"\"
    "    model.eval()",
    "    predictions_prob = []",
    "    ","    with torch.no_grad():",
    "        for batch_X, _ in data_loader:",
    "            batch_X = batch_X.to(device)",
    "            outputs = model(batch_X)",
    "            predictions_prob.append(outputs.cpu().numpy())",
    "    ","    predictions_prob = np.vstack(predictions_prob).flatten()",
    "    predictions = (predictions_prob > 0.5).astype(int)",
    "    ","    return predictions_prob, predictions",
    "","# 예제 모델 예측",
    "example_prob, example_pred = predict_with_probability(example_model, test_loader)",
    "",
    "print(f\"예측 완료!\")",
    "print(f\"예측 수: {len(example_pred)}\")",
    "print(f\"상승 예측: {np.sum(example_pred == 1)}개\")",
    "print(f\"하락 예측: {np.sum(example_pred == 0)}개\")",
    "print(f\"\n평균 상승 확률: {example_prob.mean():.2%}")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 확률 기반 트레이딩 전략",
    "def simulate_probability_trading(predictions_prob, actual_prices, dates, ",
    "                                 initial_capital=10000, transaction_fee=0.001,",
    "                                 threshold=0.5, position_scaling=True):",
    "    \"\"\"
    "    확률 기반 트레이딩 시뮬레이션",
    "    ","    Parameters:",
    "    ----------- ",
    "    predictions_prob : array",
    "        상승 확률 (0~1)",
    "    actual_prices : array",
    "        실제 가격",
    "    dates : array",
    "        날짜",
    "    initial_capital : float",
    "        초기 자본",
    "    transaction_fee : float",
    "        거래 수수료",
    "    threshold : float",
    "        매수 결정 임계값 (기본 0.5)",
    "    position_scaling : bool",
    "        True: 확률에 비례하여 투자 비율 조절",
    "        False: 임계값 초과 시 전액 투자",
    "    \"\"\"
    "    cash = initial_capital",
    "    btc_holdings = 0",
    "    portfolio_values = []",
    "    trade_log = []",
    "    ","    for i in range(len(predictions_prob)):",
    "        current_price = actual_prices[i]",
    "        prob = predictions_prob[i]",
    "        ","        # 현재 포트폴리오 가치 계산",
    "        portfolio_value = cash + btc_holdings * current_price",
    "        ","        # 마지막 날이 아닌 경우, 다음날 가격으로 포트폴리오 가치를 기록 (오늘 결정 -> 내일 결과)",
    "        if i < len(actual_prices) - 1:",
    "            portfolio_values.append(cash + btc_holdings * actual_prices[i+1])",
    "        else: # 마지막 날은 현재 가격으로 기록",
    "            portfolio_values.append(portfolio_value)",
    "","        # 투자 비율 결정",
    "        if position_scaling:",
    "            invest_ratio = prob if prob > threshold else 0",
    "        else:",
    "            invest_ratio = 1.0 if prob > threshold else 0.0",
    "        ","        # 목표 BTC 가치 및 현재 BTC 가치",
    "        target_btc_value = portfolio_value * invest_ratio",
    "        current_btc_value = btc_holdings * current_price",
    "        ","        # 포지션 조정",
    "        if target_btc_value > current_btc_value:  # 매수",
    "            buy_cash = target_btc_value - current_btc_value",
    "            if buy_cash > cash: buy_cash = cash",
    "            if buy_cash > 0:",
    "                buy_amount = (buy_cash / current_price) * (1 - transaction_fee)",
    "                btc_holdings += buy_amount",
    "                cash -= buy_cash",
    "                trade_log.append({'date': dates[i], 'action': 'BUY', 'price': current_price, 'prob': prob, 'amount': buy_amount, 'value': buy_cash})",
    "        ","        elif target_btc_value < current_btc_value: # 매도",
    "            sell_btc_value = current_btc_value - target_btc_value",
    "            sell_amount = sell_btc_value / current_price",
    "            if sell_amount > btc_holdings: sell_amount = btc_holdings",
    "            if sell_amount > 0:",
    "                sell_cash = (sell_amount * current_price) * (1 - transaction_fee)",
    "                btc_holdings -= sell_amount",
    "                cash += sell_cash",
    "                trade_log.append({'date': dates[i], 'action': 'SELL', 'price': current_price, 'prob': prob, 'amount': sell_amount, 'value': sell_btc_value})",
    "","    # 마지막 날 전량 매도",
    "    if btc_holdings > 0:",
    "        sell_cash = (btc_holdings * actual_prices[-1]) * (1 - transaction_fee)",
    "        cash += sell_cash",
    "        trade_log.append({'date': dates[-1], 'action': 'SELL_ALL', 'price': actual_prices[-1], 'prob': -1, 'amount': btc_holdings, 'value': btc_holdings * actual_prices[-1]})",
    "        btc_holdings = 0",
    "    ","    final_value = cash",
    "    total_return = (final_value - initial_capital) / initial_capital * 100",
    "    ","    total_fees_paid = sum(trade['value'] * transaction_fee for trade in trade_log if trade['action'] != 'SELL_ALL')",
    "    if trade_log and trade_log[-1]['action'] == 'SELL_ALL':",
    "        total_fees_paid += trade_log[-1]['value'] * transaction_fee",
    "","    return {",
    "        'initial_capital': initial_capital,",
    "        'final_value': final_value,",
    "        'total_return': total_return,",
    "        'portfolio_values': portfolio_values,",
    "        'trade_log': trade_log,",
    "        'num_trades': len(trade_log),",
    "        'total_fees_paid': total_fees_paid",
    "    }","print(\"✅ 트레이딩 시뮬레이션 함수 준비 완료!\")"
   ]
