    "# TODO: 자신만의 모델 구현",
    "",
    "class MyTradingModel(nn.Module):",
    "    \"\"\"
    "    GRU 기반의 트레이딩 모델",
    "    입력: (batch, sequence_length, features)",
    "    출력: (batch, 1) - 상승 확률 (0~1)",
    "    \"\"\"
    "    def __init__(self, input_size, hidden_size=128, dropout=0.3, num_layers=2):",
    "        super(MyTradingModel, self).__init__()",
    "        ","        # GRU 레이어: LSTM보다 파라미터가 적어 효율적일 수 있음",
    "        self.gru = nn.GRU(input_size, hidden_size, num_layers=num_layers, batch_first=True, dropout=dropout)",
    "        ","        # 과적합 방지를 위한 BatchNorm",
    "        self.bn1 = nn.BatchNorm1d(hidden_size)",
    "        self.dropout1 = nn.Dropout(dropout)",
    "        ","        # Fully Connected Layers",
    "        self.fc1 = nn.Linear(hidden_size, hidden_size // 2)",
    "        self.relu = nn.ReLU()",
    "        self.dropout2 = nn.Dropout(dropout)",
    "        self.bn2 = nn.BatchNorm1d(hidden_size // 2)",
    "        ","        self.fc2 = nn.Linear(hidden_size // 2, 1)",
    "        self.sigmoid = nn.Sigmoid()",
    "    ","    def forward(self, x):",
    "        # x shape: (batch_size, seq_len, input_size)",
    "        gru_out, _ = self.gru(x)",
    "        ","        # 마지막 타임스텝의 출력을 사용",
    "        out = gru_out[:, -1, :]",
    "        ","        out = self.bn1(out)",
    "        out = self.dropout1(out)",
    "        ","        out = self.fc1(out)",
    "        out = self.relu(out)",
    "        out = self.bn2(out)",
    "        out = self.dropout2(out)",
    "        ","        out = self.fc2(out)",
    "        out = self.sigmoid(out)",
    "        ","        return out",
    "","# 모델 생성",
    "my_model = MyTradingModel(",
    "    input_size=X_train_seq.shape[2],",
    "    hidden_size=128, # 예제보다 용량 증가",
    "    dropout=0.3, # 과적합 방지를 위해 dropout 증가",
    "    num_layers=2",
    "    ).to(device)",
